{
  "name": "agent-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Messaging bridge for AI coding agents (Claude Code, Codex) across sessions, apps and computers, with a hosted hub and web console.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node test/e2e.mjs",
    "test:hub": "node test/e2e.mjs",
    "build:console": "vite build --config console/vite.config.ts",
    "dev:console": "vite --config console/vite.config.ts",
    "typecheck": "tsc -p console --noEmit",
    "dev:hub": "wrangler dev",
    "deploy": "wrangler deploy",
    "local-broker": "node plugin/client/broker.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/msmith297/agentbridge.git"
  }
}
